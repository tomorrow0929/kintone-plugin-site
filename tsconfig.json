{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "amplify", "scripts"],
  "exclude": [
    // Lambda のハンドラは $amplify/env/... という Amplify が生成する型を import する。
    // ampx（sandbox / pipeline-deploy）を実行しないと存在しないため、
    // ローカルの型チェックからは除外する。Amplify のビルド時には解決される。
    "amplify/functions/*/handler.ts"
  ]
}
