# 依存パッケージ
node_modules/

# ビルド成果物
dist/

# ===== 絶対にコミットしてはいけないもの =====
# kintoneプラグインの署名用秘密鍵。流出すると第三者が
# あなたのプラグインIDで偽物を配布できてしまいます。
*.ppk
*.pem
*.key

# Amplify が自動生成する接続情報（AWSリソースのIDなどが入る）
amplify_outputs*
.amplify/
amplifyconfiguration*

# 環境変数
.env
.env.local
.env.*.local

# ログ
npm-debug.log*

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
